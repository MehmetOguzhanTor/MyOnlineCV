---
import Base from '../layouts/Base.astro';
import { dict, languages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
const email = 'mehmetoguzhantor@gmail.com';
const linkedin = 'https://www.linkedin.com/in/mehmet-oguzhan-tor';
const github = 'https://github.com/MehmetOguzhanTor';
---

<Base lang={lang}>
  <div class="shell">
    <header class="side">
      <a class="brand" href="#about">
        <img src="/photo.jpg" alt="" width="96" height="96" />
        <span>
          <span class="brand-name">Mehmet Oğuzhan Tor</span>
          <span class="brand-role">{t.role}</span>
        </span>
      </a>

      <nav aria-label={t.ui.menu}>
        <ul class="nav">
          <li><a href="#about">{t.nav.about}</a></li>
          <li><a href="#projects">{t.nav.projects}</a></li>
          <li><a href="#experience">{t.nav.experience}</a></li>
          <li><a href="#cv">{t.nav.cv}</a></li>
          <li><a href="#now">{t.nav.now}</a></li>
          <li><a href="#contact">{t.nav.contact}</a></li>
        </ul>
      </nav>

      <div class="controls">
        <div class="lang" role="group" aria-label={t.ui.language}>
          {
            languages.map((l) => (
              <a href={l.href} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
                {l.label}
              </a>
            ))
          }
          <span class="lang-soon" title={t.ui.deSoon} aria-disabled="true">DE</span>
        </div>
        <button
          type="button"
          class="theme-btn"
          id="themeBtn"
          data-dark={t.ui.dark}
          data-light={t.ui.light}
        >
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <span class="theme-label">{t.ui.dark}</span>
        </button>
      </div>
    </header>

    <main>
      <section class="hero" id="about">
        <p class="lede">{t.lede}</p>
        <div class="ctas">
          <a class="btn primary" href="#experience">{t.cta.experience}</a>
          <a class="btn ghost" href="#contact">{t.cta.contact}</a>
        </div>
      </section>

      <section id="projects">
        <h2 class="sec-head">{t.h.projects}</h2>
        <div class="projects">
          {
            t.projects.map((p) => (
              <article class="proj">
                <span class="proj-when">{p.when}</span>
                <div class="proj-body">
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
                <ul class="tags">
                  {p.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="experience">
        <h2 class="sec-head">{t.h.experience}</h2>
        <ul class="exp">
          {
            t.experience.map((e) => (
              <li>
                <span class="when">{e.when}</span>
                <div>
                  <h3>
                    {e.title} <span class="org">· {e.org}</span>
                  </h3>
                  <p>{e.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="cv-box" id="cv">
          <p>{t.cvBox}</p>
          <a class="btn primary" href={linkedin} target="_blank" rel="noopener">{t.cvCta}</a>
        </div>
      </section>

      <section id="now">
        <div class="sec-row">
          <h2 class="sec-head">{t.h.now}</h2>
          <span class="stamp">{t.nowStamp}</span>
        </div>
        <div class="now">
          {
            t.now.map((n) => (
              <div class="now-item">
                <h3>{n.h}</h3>
                <p>{n.p}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="contact" class="contact">
        <h2 class="sec-head">{t.h.contact}</h2>
        <p class="contact-h">{t.contactH}</p>
        <p class="muted">{t.contactText}</p>
        <div class="mail">
          <a class="mail-addr" href={`mailto:${email}`}>{email}</a>
          <button type="button" class="copy" id="copyBtn" data-email={email} data-copy={t.ui.copy} data-copied={t.ui.copied}>
            {t.ui.copy}
          </button>
        </div>
        <ul class="socials">
          <li><a href={linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={github} target="_blank" rel="noopener">GitHub</a></li>
        </ul>
      </section>

      <footer class="foot">© {new Date().getFullYear()} Mehmet Oğuzhan Tor</footer>
    </main>
  </div>

  <script>
    const root = document.documentElement;
    const btn = document.getElementById('themeBtn') as HTMLButtonElement;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);

    function paint() {
      const label = isDark() ? btn.dataset.light! : btn.dataset.dark!;
      btn.querySelector('.theme-label')!.textContent = label;
      btn.setAttribute('aria-label', label);
      btn.classList.toggle('is-dark', isDark());
    }

    btn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      paint();
    });
    mq.addEventListener('change', paint);
    paint();

    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email!);
        copyBtn.textContent = copyBtn.dataset.copied!;
        setTimeout(() => (copyBtn.textContent = copyBtn.dataset.copy!), 1600);
      } catch (e) {
        const range = document.createRange();
        range.selectNodeContents(document.querySelector('.mail-addr')!);
        const sel = getSelection()!;
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });
  </script>
</Base>
