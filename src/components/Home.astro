---
import Base from '../layouts/Base.astro';
import Scope from './Scope.astro';
import Socials from './Socials.astro';
import { dict, languages, type Lang, type Project } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
const projects = t.projects as Project[];
const email = 'mehmetoguzhantor@gmail.com';
const cvPdf = '/Mehmet-Oguzhan-Tor-CV.pdf';

const sections = [
  { id: 'about', label: t.nav.about },
  { id: 'experience', label: t.nav.experience },
  { id: 'projects', label: t.nav.projects },
  { id: 'now', label: t.nav.now },
  { id: 'contact', label: t.nav.contact },
];
---

<Base lang={lang}>
  <Scope />
  <div class="shell">
    <header class="side">
      <a class="brand" href="#about">
        <img src="/photo.jpg" alt="" width="96" height="96" />
        <span>
          <span class="brand-name">Mehmet Oğuzhan Tor</span>
          <span class="brand-role">{t.role}</span>
        </span>
      </a>

      <nav aria-label={t.ui.menu}>
        <ul class="nav" id="nav">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} data-section={s.id}>
                  <span class="nav-line" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="controls">
        <Socials class="side-socials" />
        <a class="cv-link" href="/cv/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg>
          {t.cv.view}
        </a>
        <div class="lang" role="group" aria-label={t.ui.language}>
          {
            languages.map((l) => (
              <a href={l.href} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
                {l.label}
              </a>
            ))
          }
          <span class="lang-soon" title={t.ui.deSoon} aria-disabled="true">DE</span>
        </div>
        <button type="button" class="theme-btn" id="themeBtn" data-dark={t.ui.dark} data-light={t.ui.light}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <span class="theme-label">{t.ui.dark}</span>
        </button>
      </div>
    </header>

    <main>
      <section class="hero" id="about" data-observe>
        <p class="lede">{t.lede}</p>
        <div class="ctas">
          <a class="btn primary" href="#experience">{t.cta.experience}</a>
          <a class="btn ghost" href={cvPdf} download>{t.cv.download}</a>
        </div>
      </section>

      <section id="experience" data-observe>
        <h2 class="sec-head">{t.h.experience}</h2>
        <ul class="exp">
          {
            t.experience.map((e) => (
              <li>
                <div class={`logos${e.logos.length > 1 ? ' pair' : ''}`}>
                  {e.logos.length ? (
                    e.logos.map((l) => <img src={l.src} alt={l.alt} title={l.alt} width="40" height="40" loading="lazy" />)
                  ) : (
                    <span class="mono" aria-hidden="true">{e.mono}</span>
                  )}
                </div>
                <div class="exp-body">
                  <span class="when">{e.when}</span>
                  <h3>
                    {e.title} <span class="org">· {e.org}</span>
                  </h3>
                  <p>{e.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="cv-box" id="cv">
          <p>{t.cv.box}</p>
          <div class="ctas">
            <a class="btn primary" href="/cv/">{t.cv.view}</a>
            <a class="btn ghost" href={cvPdf} download>{t.cv.download}</a>
          </div>
        </div>
      </section>

      <section id="projects" data-observe>
        <h2 class="sec-head">{t.h.projects}</h2>
        <div class="projects">
          {
            projects.map((p) => (
              <article class="proj">
                <div class="proj-thumb" aria-hidden={p.image ? undefined : 'true'}>
                  {p.image ? (
                    <img src={p.image} alt={p.imageAlt ?? p.title} loading="lazy" />
                  ) : (
                    <>
                      <span class="thumb-label">{p.when}</span>
                      <svg class="thumb-wave" viewBox="0 0 120 40" preserveAspectRatio="none">
                        <path d="M0 20 Q 7.5 4 15 20 T 30 20 T 45 20 T 60 20 T 75 20 T 90 20 T 105 20 T 120 20" />
                      </svg>
                    </>
                  )}
                </div>
                <div class="proj-body">
                  <h3>
                    {p.links?.[0] ? (
                      <a href={p.links[0].href} target="_blank" rel="noopener">
                        {p.title}
                        <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      p.title
                    )}
                  </h3>
                  {p.result && <p class="result">{p.result}</p>}
                  <p>{p.text}</p>
                  <ul class="tags">
                    {p.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="now" data-observe>
        <div class="sec-row">
          <h2 class="sec-head">{t.h.now}</h2>
          <span class="stamp">{t.nowStamp}</span>
        </div>
        <div class="now">
          {
            t.now.map((n) => (
              <div class="now-item">
                <h3>{n.h}</h3>
                <p>{n.p}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="contact" class="contact" data-observe>
        <h2 class="sec-head">{t.h.contact}</h2>
        <p class="contact-h">{t.contactH}</p>
        <p class="muted">{t.contactText}</p>
        <div class="mail">
          <a class="mail-addr" href={`mailto:${email}`}>{email}</a>
          <button type="button" class="copy" id="copyBtn" data-email={email} data-copy={t.ui.copy} data-copied={t.ui.copied}>
            {t.ui.copy}
          </button>
        </div>
        <Socials class="contact-socials" />
      </section>

      <footer class="foot">© {new Date().getFullYear()} Mehmet Oğuzhan Tor</footer>
    </main>
  </div>

  <script>
    import { initTheme } from '../scripts/theme';
    initTheme();

    // Highlight the nav entry of the section currently in view.
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('#nav a[data-section]').forEach((a) => links.set(a.dataset.section!, a));
    const setActive = (id: string) => {
      links.forEach((a, key) => {
        if (key === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    document.querySelectorAll('[data-observe]').forEach((s) => observer.observe(s));
    // At the very bottom the last section may never cross the trigger line.
    window.addEventListener(
      'scroll',
      () => {
        if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) setActive('contact');
      },
      { passive: true },
    );
    setActive('about');

    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email!);
        copyBtn.textContent = copyBtn.dataset.copied!;
        setTimeout(() => (copyBtn.textContent = copyBtn.dataset.copy!), 1600);
      } catch (e) {
        const range = document.createRange();
        range.selectNodeContents(document.querySelector('.mail-addr')!);
        const sel = getSelection()!;
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });
  </script>
</Base>
